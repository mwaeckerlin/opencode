# OpenCode runs its tools (bash, edit, write) in the process that talks to the
# model, so it lives in the sandbox with the full toolset of
# mwaeckerlin/sandbox-base and holds no secret at all; the keys stay in the
# gateway image. OpenCode itself and the configuration from the environment
# come with mwaeckerlin/sandbox-base; this image runs it as the central server
# with its web interface.

#
# With OPENCODE_BASE_PATH, the front process base-path/serve.mjs starts
# OpenCode on the loopback interface and serves it below that path; the build
# stops when the interface of this OpenCode release no longer carries the code
# the front process adjusts (base-path/patch-upstream.mjs).

FROM mwaeckerlin/sandbox-base AS sandbox
ENV CONTAINERNAME="opencode" \
    OPENCODE_GATEWAY_URL="http://opencode-gateway:8080" \
    HINDSIGHT_SHARED_BANK="shared" \
    HINDSIGHT_OWN_BANK="opencode" \
    OPENCODE_PORT="4096" \
    OPENCODE_BASE_PATH=""
COPY base-path/configuration.mjs base-path/serve.mjs base-path/patch-upstream.mjs base-path/opencode-base-path.js /usr/local/lib/opencode-base-path/
RUN node /usr/local/lib/opencode-base-path/patch-upstream.mjs verify
COPY --chmod=0755 files/sandbox-entrypoint.sh /entrypoint.sh
RUN install -d -o ${RUN_USER} -g ${RUN_GROUP} /workspace
EXPOSE 4096
VOLUME ["/workspace"]
WORKDIR /workspace
USER ${RUN_USER}
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD nc -z localhost "${OPENCODE_PORT}" || exit 1
ENTRYPOINT ["/entrypoint.sh"]

FROM sandbox
